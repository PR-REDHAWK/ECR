router.get('/my-bookings', protect, async (req, res) => {
  try {
    const [bookings] = await db.query(
      `SELECT b.*, p.name AS product_name
       FROM bookings b
       JOIN products p ON b.product_id = p.id
       WHERE b.user_id = ?`,
      [req.user.id]
    );

    res.json(bookings);
  } catch (err) {
    res.status(500).json({ message: 'Failed to fetch bookings' });
  }
});